<Window x:Class="MyTaskbar.TrayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TrayWindow"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        Width="Auto"
        SizeToContent="Height"
        Opacity="0"
        Deactivated="Window_Deactivated">
    <Border x:Name="RootBorder"
            Background="Transparent"
            BorderBrush="#30FFFFFF"
            BorderThickness="1,1,1,0"
            Padding="4,4,4,4">
        <StackPanel>
            <Border Height="1" Margin="-4,-4,-4,4" Background="#30FFFFFF"/>
            <WrapPanel x:Name="IconsPanel" Orientation="Horizontal"/>
            <TextBlock x:Name="EmptyLabel"
                       Text="Нет значков"
                       Foreground="#80FFFFFF"
                       FontSize="10"
                       FontFamily="Segoe UI"
                       Margin="6,2,6,2"
                       Visibility="Collapsed"/>
        </StackPanel>
    </Border>
</Window>