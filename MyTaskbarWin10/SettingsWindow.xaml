<Window x:Class="MyTaskbar.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MyTaskbar — Settings"
        Width="380" Height="auto"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        ShowInTaskbar="False"
        Background="Transparent"
        Foreground="#CDD6F4"
        FontFamily="Segoe UI"
        FontSize="13"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">

    <Window.Resources>
        <!-- Toggle button style (Win11-style rounded toggle) -->
        <Style x:Key="ToggleStyle" TargetType="CheckBox">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid Width="44" Height="24">
                            <Rectangle x:Name="Track" RadiusX="12" RadiusY="12"
                                       Fill="#45475A" Stroke="Transparent"/>
                            <Ellipse x:Name="Thumb" Width="16" Height="16"
                                     Fill="White" HorizontalAlignment="Left"
                                     Margin="4,0,0,0" VerticalAlignment="Center"/>
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CheckStates">
                                    <VisualState x:Name="Checked">
                                        <Storyboard>
                                            <ColorAnimation Storyboard.TargetName="Track"
                                                Storyboard.TargetProperty="(Rectangle.Fill).(SolidColorBrush.Color)"
                                                To="#0067C0" Duration="0:0:0.15"/>
                                            <ThicknessAnimation Storyboard.TargetName="Thumb"
                                                Storyboard.TargetProperty="Margin"
                                                To="24,0,0,0" Duration="0:0:0.15"/>
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="Unchecked">
                                        <Storyboard>
                                            <ColorAnimation Storyboard.TargetName="Track"
                                                Storyboard.TargetProperty="(Rectangle.Fill).(SolidColorBrush.Color)"
                                                To="#45475A" Duration="0:0:0.15"/>
                                            <ThicknessAnimation Storyboard.TargetName="Thumb"
                                                Storyboard.TargetProperty="Margin"
                                                To="4,0,0,0" Duration="0:0:0.15"/>
                                        </Storyboard>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Accent button style -->
        <Style x:Key="AccentButton" TargetType="Button">
            <Setter Property="Background" Value="#89B4FA"/>
            <Setter Property="Foreground" Value="#1E1E2E"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="18,5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="0" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#B4BEFE"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#74C7EC"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Grey button style (for Close button) -->
        <Style x:Key="GreyButton" TargetType="Button">
            <Setter Property="Background" Value="#45475A"/>
            <Setter Property="Foreground" Value="#BAC2DE"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="18,5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                CornerRadius="0" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              IsHitTestVisible="False"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#585B70"/>
                                <Setter Property="Foreground" Value="#CDD6F4"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#313244"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Ghost button style -->
        <Style x:Key="GhostButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#6C7086"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="18,5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                CornerRadius="0" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              IsHitTestVisible="False"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#313244"/>
                                <Setter Property="Foreground" Value="#CDD6F4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Position radio button style -->
        <Style x:Key="PosRadio" TargetType="RadioButton">
            <Setter Property="Foreground" Value="#BAC2DE"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" Background="#313244" CornerRadius="0"
                                BorderBrush="Transparent" BorderThickness="2"
                                Padding="14,10" Cursor="Hand">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <TextBlock x:Name="Icon" FontSize="18" Margin="0,0,8,0"
                                           Text="{TemplateBinding Tag}"/>
                                <TextBlock Text="{TemplateBinding Content}"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#89B4FA"/>
                                <Setter TargetName="Bd" Property="Background" Value="#1E3A5F"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#45475A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Scale button style -->
        <Style x:Key="ScaleBtn" TargetType="Button">
            <Setter Property="Background" Value="#313244"/>
            <Setter Property="Foreground" Value="#CDD6F4"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width" Value="34"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#45475A"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#89B4FA"/>
                                <Setter Property="Foreground" Value="#1E1E2E"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="Transparent" CornerRadius="0" Padding="0"
            BorderBrush="#33FFFFFF" BorderThickness="0,1,1,1">
        <StackPanel>

        <!-- Custom title bar -->
            <!-- Custom title bar -->
            <Border Background="#60101018" CornerRadius="0" Padding="0">
                <Grid Height="34">
                    <TextBlock Text="Settings" FontSize="18" FontWeight="SemiBold"
                   Foreground="White" VerticalAlignment="Center"
                   Margin="8,0,0,0"/>
                    <Button x:Name="BtnTitleClose" HorizontalAlignment="Right"
                Width="34" Height="34" Click="BtnClose_Click"
                ToolTip="Close">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Bd" Background="Transparent" CornerRadius="0">
                                    <TextBlock Text="✕" FontSize="20" Foreground="White"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   IsHitTestVisible="False"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="#C40000"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>
            </Border>

            <Border Padding="8,8,8,8">
        <StackPanel>

            <!-- POSITION section -->
            <TextBlock Text="POSITION" FontSize="10" FontWeight="Bold"
                       Foreground="#6C7086" Margin="0,0,0,10"/>

            <Grid Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <RadioButton x:Name="RadioTop" Grid.Column="0"
                             Content="Top" Tag="▲" Style="{StaticResource PosRadio}"
                             Checked="RadioTop_Checked"/>
                <RadioButton x:Name="RadioBottom" Grid.Column="2"
                             Content="Bottom" Tag="▼" Style="{StaticResource PosRadio}"
                             Checked="RadioBottom_Checked"/>
            </Grid>

            <!-- Separator -->
            <Rectangle Height="1" Fill="#313244" Margin="0,0,0,20"/>

            <!-- SIZE section -->
            <TextBlock Text="SIZE" FontSize="10" FontWeight="Bold"
                       Foreground="#6C7086" Margin="0,0,0,12"/>

            <Grid Margin="0,0,0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Taskbar Scale" Foreground="#BAC2DE" VerticalAlignment="Center"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button x:Name="BtnScaleDown" Content="−" Style="{StaticResource ScaleBtn}"
                            Click="BtnScaleDown_Click"/>
                    <TextBlock x:Name="TxtScale" Width="54" TextAlignment="Center"
                               Foreground="#CDD6F4" FontSize="14" FontWeight="SemiBold"
                               VerticalAlignment="Center"/>
                    <Button x:Name="BtnScaleUp" Content="+" Style="{StaticResource ScaleBtn}"
                            Click="BtnScaleUp_Click"/>
                </StackPanel>
            </Grid>

            <!-- Scale bar -->
            <Grid Margin="0,8,0,20" Height="6">
                <Rectangle Fill="#313244" RadiusX="0" RadiusY="0"/>
                <Rectangle x:Name="ScaleBar" Fill="#89B4FA" RadiusX="0" RadiusY="0"
                           HorizontalAlignment="Left"/>
            </Grid>

            <!-- Separator -->
            <Rectangle Height="1" Fill="#313244" Margin="0,0,0,20"/>

            <!-- GAMES section -->
            <TextBlock Text="GAMES &amp; FULLSCREEN" FontSize="10" FontWeight="Bold"
                       Foreground="#6C7086" Margin="0,0,0,14"/>

            <!-- Auto-hide in fullscreen toggle -->
            <Grid Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Auto-hide in fullscreen apps" Foreground="#BAC2DE"/>
                    <TextBlock Text="Hides the bar when a fullscreen game or app is detected"
                               FontSize="11" Foreground="#6C7086" Margin="0,2,0,0"
                               TextWrapping="Wrap"/>
                </StackPanel>
                <CheckBox x:Name="ToggleFullscreen" Grid.Column="1"
                          Style="{StaticResource ToggleStyle}"
                          VerticalAlignment="Center"
                          Checked="ToggleFullscreen_Changed"
                          Unchecked="ToggleFullscreen_Changed"/>
            </Grid>

            <!-- Separator -->
            <Rectangle Height="1" Fill="#313244" Margin="0,0,0,20"/>

            <!-- Footer buttons -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="BtnClose" Content="Close" Style="{StaticResource GreyButton}"
                        Click="BtnClose_Click" Margin="0,0,8,0"/>
                <Button x:Name="BtnApply" Content="Apply" Style="{StaticResource AccentButton}"
                        Click="BtnApply_Click"/>
            </StackPanel>

        </StackPanel>
        </Border>
        </StackPanel>
    </Border>
</Window>
