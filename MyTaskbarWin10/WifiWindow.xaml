<Window x:Class="MyTaskbar.WifiWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WifiWindow"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        Width="270"
        Deactivated="Window_Deactivated">

    <Border x:Name="RootBorder"
            Background="Transparent"
            BorderBrush="#33FFFFFF"
            BorderThickness="1,0,0,1">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- ══ ПОДКЛЮЧЁННАЯ СЕТЬ — синий блок ══ -->
            <Border x:Name="ConnectedBlock"
                    Grid.Row="0"
                    Background="#221A4A73"
                    Visibility="Collapsed"
                    Padding="12,12,12,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="32"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <ContentControl x:Name="ConnectedIcon"
                                    Grid.Column="0" Grid.Row="0" Grid.RowSpan="2"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Width="32"
                                    Height="32">
                        <TextBlock Text="&#xE701;"
                                   FontFamily="Segoe MDL2 Assets" FontSize="20"
                                   Foreground="White"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </ContentControl>

                    <TextBlock x:Name="ConnectedSsidLabel"
                               Grid.Column="1" Grid.Row="0"
                               Text="Сеть"
                               Foreground="White" FontSize="13"
                               FontWeight="SemiBold" FontFamily="Segoe UI"/>

                    <TextBlock x:Name="ConnectedStatusLabel"
                               Grid.Column="1" Grid.Row="1"
                               Text="Подключено, защищено"
                               Foreground="#AAAAAA" FontSize="11" FontFamily="Segoe UI"/>

                    <StackPanel Grid.Column="1" Grid.Row="2"
                                Orientation="Horizontal" Margin="0,10,0,10">
                        <Button x:Name="PropertiesButton" Click="PropertiesButton_Click"
                                Background="Transparent" BorderThickness="0"
                                Cursor="Hand" Focusable="False" Padding="0">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <TextBlock x:Name="tb" Text="Свойства"
                                               Foreground="#5BA3E0" FontSize="11"
                                               FontFamily="Segoe UI" TextDecorations="Underline"/>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="tb" Property="Foreground" Value="#88C4FF"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Кнопка "Отключиться" -->
            <Border x:Name="DisconnectBlock"
                    Grid.Row="1"
                    Background="#221A4A73"
                    Visibility="Collapsed"
                    Padding="12,0,12,12">
                <Button x:Name="DisconnectButton" Click="DisconnectButton_Click"
                        HorizontalAlignment="Right"
                        BorderThickness="0" Cursor="Hand" Focusable="False">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="bg" Background="#0078D4" Padding="14,5">
                                <TextBlock Text="Отключиться" Foreground="White"
                                           FontSize="12" FontFamily="Segoe UI"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bg" Property="Background" Value="#106EBE"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="bg" Property="Background" Value="#333333"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Border>

            <!-- ══ СПИСОК СЕТЕЙ ══ -->
            <ScrollViewer x:Name="NetworkScroll"
                          Grid.Row="2"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <ScrollViewer.Resources>
                    <Style TargetType="RepeatButton">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Setter Property="Height" Value="0"/>
                    </Style>
                    <Style TargetType="ScrollBar">
                        <Setter Property="Width" Value="3"/>
                        <Setter Property="MinWidth" Value="3"/>
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ScrollBar">
                                    <Grid Width="3" Background="Transparent">
                                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                                            <Track.DecreaseRepeatButton>
                                                <RepeatButton Opacity="0" IsHitTestVisible="False"/>
                                            </Track.DecreaseRepeatButton>
                                            <Track.IncreaseRepeatButton>
                                                <RepeatButton Opacity="0" IsHitTestVisible="False"/>
                                            </Track.IncreaseRepeatButton>
                                            <Track.Thumb>
                                                <Thumb>
                                                    <Thumb.Template>
                                                        <ControlTemplate TargetType="Thumb">
                                                            <Border Background="#44FFFFFF"/>
                                                        </ControlTemplate>
                                                    </Thumb.Template>
                                                </Thumb>
                                            </Track.Thumb>
                                        </Track>
                                    </Grid>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ScrollViewer.Resources>
                <StackPanel x:Name="NetworkList"/>
            </ScrollViewer>

            <!-- Статус -->
            <TextBlock x:Name="StatusLabel"
                       Grid.Row="3"
                       Text="Сканирование..."
                       Foreground="#888888" FontSize="11" FontFamily="Segoe UI"
                       HorizontalAlignment="Center"
                       Margin="0,6,0,6" Visibility="Visible"/>

            <!-- ══ РАЗДЕЛИТЕЛЬ ══ -->
            <Rectangle Grid.Row="4" Height="1" Fill="#33FFFFFF"/>

            <!-- ══ ПАРАМЕТРЫ СЕТИ И ИНТЕРНЕТ ══ -->
            <Border Grid.Row="5" Padding="12,8,12,6">
                <Button x:Name="NetworkSettingsButton" Click="NetworkSettingsButton_Click"
                        Background="Transparent" BorderThickness="0"
                        HorizontalAlignment="Left" Cursor="Hand"
                        Focusable="False" Padding="0">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <TextBlock x:Name="t1"
                                       Text="Параметры сети и Интернет"
                                       Foreground="#5BA3E0" FontSize="12"
                                       FontFamily="Segoe UI" FontWeight="SemiBold"/>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="t1" Property="Foreground" Value="#88C4FF"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Border>

            <!-- ══ ПЛИТКИ: Wi-Fi / Самолёт / Хот-спот ══ -->
            <Border Grid.Row="6" Padding="5,2,5,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Wi-Fi плитка -->
                    <Border x:Name="WifiTile" Grid.Column="0"
                            Margin="3,0,3,0" Height="48"
                            Background="#0078D4"
                            BorderBrush="#88FFFFFF" BorderThickness="1"
                            Cursor="Hand"
                            MouseLeftButtonUp="WifiTile_Click">
                        <TextBlock x:Name="WifiTileIcon"
                                   Text="Wi-Fi"
                                   FontFamily="Segoe UI"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Foreground="White"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   TextOptions.TextFormattingMode="Ideal"
                                   RenderOptions.ClearTypeHint="Enabled"/>
                    </Border>

                    <!-- Режим полёта -->
                    <Border x:Name="AirplaneTile" Grid.Column="1"
                            Margin="3,0,3,0" Height="48"
                            Background="#2A2A2A"
                            BorderBrush="#88FFFFFF" BorderThickness="1"
                            Cursor="Hand"
                            MouseLeftButtonUp="AirplaneTile_Click">
                        <Viewbox Width="22" Height="22"
                                 HorizontalAlignment="Center"
                                 VerticalAlignment="Center"
                                 Stretch="Uniform">
                            <TextBlock x:Name="AirplaneTileIcon"
                                       Text="&#xE709;"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="20"
                                       Foreground="#CCCCCC"
                                       TextOptions.TextFormattingMode="Ideal"
                                       RenderOptions.ClearTypeHint="Enabled"/>
                        </Viewbox>
                    </Border>

                    <!-- Хот-спот — SVG иконка (точка с волнами) -->
                    <!-- Хот-спот — SVG иконка (точка с волнами) -->
                    <Border x:Name="HotspotTile" Grid.Column="2"
        Margin="3,0,3,0" Height="48"
        Background="#2A2A2A"
        BorderBrush="#88FFFFFF" BorderThickness="1"
        Cursor="Hand"
        MouseLeftButtonUp="HotspotTile_Click">
                        <Viewbox Width="33" Height="33"
             HorizontalAlignment="Center"
             VerticalAlignment="Center"
             Stretch="Uniform">
                            <Canvas Width="24" Height="24">
                                <!-- Центральная точка -->
                                <Ellipse Canvas.Left="10" Canvas.Top="10"
                     Width="4" Height="4"
                     Fill="#CCCCCC"/>
                                <!-- Внутренние дуги -->
                                <Path Fill="#CCCCCC"
                  Data="M 7.5,12 A 4.5,4.5 0 0 1 9.2,8.8 L 8.1,7.7 A 6,6 0 0 0 6,12 A 6,6 0 0 0 8.1,16.3 L 9.2,15.2 A 4.5,4.5 0 0 1 7.5,12 Z"/>
                                <Path Fill="#CCCCCC"
                  Data="M 16.5,12 A 4.5,4.5 0 0 1 14.8,15.2 L 15.9,16.3 A 6,6 0 0 0 18,12 A 6,6 0 0 0 15.9,7.7 L 14.8,8.8 A 4.5,4.5 0 0 1 16.5,12 Z"/>
                                <!-- Внешние дуги -->
                                <Path Fill="#CCCCCC"
                  Data="M 5,12 A 7,7 0 0 1 7.1,7.1 L 5.9,5.9 A 8.8,8.8 0 0 0 3.2,12 A 8.8,8.8 0 0 0 5.9,18.1 L 7.1,16.9 A 7,7 0 0 1 5,12 Z"/>
                                <Path Fill="#CCCCCC"
                  Data="M 19,12 A 7,7 0 0 1 16.9,16.9 L 18.1,18.1 A 8.8,8.8 0 0 0 20.8,12 A 8.8,8.8 0 0 0 18.1,5.9 L 16.9,7.1 A 7,7 0 0 1 19,12 Z"/>
                            </Canvas>
                        </Viewbox>
                    </Border>

                </Grid>
            </Border>

        </Grid>
    </Border>
</Window>