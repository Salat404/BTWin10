<Window x:Class="MyTaskbar.VolumeFlyoutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="VolumeFlyout"
        Width="220" SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        SourceInitialized="Window_SourceInitialized"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="NoResize">

    <Border x:Name="RootBorder"
            Background="Transparent"
            BorderBrush="#44FFFFFF"
            BorderThickness="1"
            CornerRadius="0"
            Padding="0,6">
        <StackPanel>

            <Button x:Name="DeviceChevronButton"
                    Background="Transparent"
                    BorderThickness="0"
                    Cursor="Hand"
                    Click="DeviceChevronButton_Click"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Stretch"
                    Padding="0">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="#01000000" Padding="10,5">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="20"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="DeviceLabel"
                                           Grid.Column="0"
                                           Text="Устройство вывода"
                                           Foreground="#DDFFFFFF"
                                           FontSize="11" FontFamily="Segoe UI"
                                           VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis"/>
                                <TextBlock x:Name="ChevronIcon"
                                           Grid.Column="1"
                                           Text="&#xE70D;"
                                           FontFamily="Segoe MDL2 Assets"
                                           FontSize="14" Foreground="#CCFFFFFF"
                                           VerticalAlignment="Center"
                                           HorizontalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#22FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#18FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>

            <StackPanel x:Name="DeviceList" Visibility="Collapsed" Margin="0,2,0,2"/>

            <Border x:Name="DeviceListSeparator"
                    Height="1" Background="#33FFFFFF"
                    Margin="10,4,10,4" Visibility="Collapsed"/>

            <!-- Mute + Слайдер + Процент -->
            <Grid Margin="10,7,10,5" Height="28" VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="26"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="28"/>
                </Grid.ColumnDefinitions>

                <Button x:Name="MuteButton"
                        Grid.Column="0"
                        Width="22" Height="22"
                        Background="Transparent" BorderThickness="0"
                        Cursor="Hand" Click="MuteButton_Click"
                        VerticalAlignment="Center" HorizontalAlignment="Left">
                    <TextBlock x:Name="MuteIcon"
                               Text="&#xE767;"
                               FontFamily="Segoe MDL2 Assets" FontSize="14"
                               Foreground="White"
                               VerticalAlignment="Center" HorizontalAlignment="Center"/>
                </Button>

                <!-- Кастомный слайдер -->
                <Border x:Name="SliderTrackBorder"
                        Grid.Column="1"
                        Height="28"
                        Background="#01000000"
                        Margin="4,0"
                        Cursor="Hand"
                        VerticalAlignment="Center">
                    <Grid>
                        <Border Height="3" VerticalAlignment="Center"
                                Background="#44FFFFFF" CornerRadius="1.5"
                                IsHitTestVisible="False"/>
                        <Border x:Name="SliderFill"
                                Height="3" VerticalAlignment="Center"
                                HorizontalAlignment="Left"
                                Background="#FF0078D4" CornerRadius="1.5,0,0,1.5"
                                IsHitTestVisible="False"
                                Width="0"/>
                        <Border x:Name="SliderThumb"
                                Width="8" Height="24"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Left"
                                Background="#FF0078D4"
                                CornerRadius="0"
                                IsHitTestVisible="False"
                                Margin="0"/>
                    </Grid>
                </Border>

                <TextBlock x:Name="VolumePercent"
                           Grid.Column="2"
                           Text="50"
                           Foreground="#DDFFFFFF" FontSize="11" FontFamily="Segoe UI"
                           VerticalAlignment="Center" HorizontalAlignment="Right"/>
            </Grid>

        </StackPanel>
    </Border>
</Window>