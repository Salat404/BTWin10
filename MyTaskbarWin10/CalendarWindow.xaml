<Window x:Class="MyTaskbar.CalendarWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        Focusable="False">
    <Window.Resources>
        <Style x:Key="NavButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#333333"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Width" Value="20"/>
            <Setter Property="Height" Value="20"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Name="border">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#444444"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid Background="Transparent">
        <Border x:Name="RootBorder"
                Background="Transparent"
                BorderBrush="#22FFFFFF"
                BorderThickness="0,1,1,1"
                CornerRadius="0"
                Padding="6,4,6,4">
            <StackPanel>
                <!-- Header with month/year and navigation -->
                <Grid Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="20"/>
                    </Grid.ColumnDefinitions>
                    
                    <!-- Previous button -->
                    <Button x:Name="PrevButton" 
                            Grid.Column="0"
                            Style="{StaticResource NavButtonStyle}"
                            Content="◀"/>
                    
                    <!-- Month/Year text -->
                    <TextBlock x:Name="HeaderText" 
                               Grid.Column="1"
                               Foreground="#FFFFFF" 
                               FontSize="13" 
                               FontWeight="Bold"
                               FontFamily="Segoe UI"
                               TextAlignment="Center"
                               VerticalAlignment="Center"/>
                    
                    <!-- Next button -->
                    <Button x:Name="NextButton" 
                            Grid.Column="2"
                            Style="{StaticResource NavButtonStyle}"
                            Content="▶"/>
                </Grid>
                
                <!-- Days of week (Mon-Sun) -->
                <UniformGrid Columns="7" Margin="0,0,0,2">
                    <TextBlock Text="Mon" Foreground="#AAAAAA" FontSize="10" 
                               FontFamily="Segoe UI" TextAlignment="Center" Height="16"/>
                    <TextBlock Text="Tue" Foreground="#AAAAAA" FontSize="10"
                               FontFamily="Segoe UI" TextAlignment="Center" Height="16"/>
                    <TextBlock Text="Wed" Foreground="#AAAAAA" FontSize="10"
                               FontFamily="Segoe UI" TextAlignment="Center" Height="16"/>
                    <TextBlock Text="Thu" Foreground="#AAAAAA" FontSize="10"
                               FontFamily="Segoe UI" TextAlignment="Center" Height="16"/>
                    <TextBlock Text="Fri" Foreground="#AAAAAA" FontSize="10"
                               FontFamily="Segoe UI" TextAlignment="Center" Height="16"/>
                    <TextBlock Text="Sat" Foreground="#AAAAAA" FontSize="10"
                               FontFamily="Segoe UI" TextAlignment="Center" Height="16"/>
                    <TextBlock Text="Sun" Foreground="#AAAAAA" FontSize="10"
                               FontFamily="Segoe UI" TextAlignment="Center" Height="16"/>
                </UniformGrid>
                
                <!-- Calendar grid (days 1-31) -->
                <ItemsControl x:Name="CalendarPanel">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="7" IsItemsHost="True"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Day}" 
                                       Foreground="{Binding Foreground}"
                                       FontSize="11"
                                       FontFamily="Segoe UI"
                                       TextAlignment="Center"
                                       VerticalAlignment="Center"
                                       Width="26"
                                       Height="20"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>
    </Grid>
</Window>
