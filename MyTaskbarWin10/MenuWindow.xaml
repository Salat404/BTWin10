<Window x:Class="MyTaskbar.MenuWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Menu"
        Width="380"
        SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize">

    <Border Background="Transparent"
            BorderBrush="#22FFFFFF"
            BorderThickness="0,1,1,1"
            CornerRadius="0">
        <StackPanel>

            <!-- Верхняя панель управления -->
            <Grid x:Name="TopBarGrid" Height="36" Background="#40000000">
                <Grid.ColumnDefinitions>
                    <!-- Колонка для кнопки питания + выезжающих кнопок -->
                    <ColumnDefinition x:Name="ColPower" Width="36"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition x:Name="ColSearch" Width="36"/>
                    <ColumnDefinition x:Name="ColSettings" Width="36"/>
                </Grid.ColumnDefinitions>

                <!-- ⏻ Питание / Shutdown -->
                <Button x:Name="BtnPower" Grid.Column="0"
                        Cursor="Hand" ToolTip="Shut down" Click="Power_Click"
                        Panel.ZIndex="10">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="bd" Background="Transparent" BorderThickness="0">
                                <TextBlock Text="&#xE7E8;" FontFamily="Segoe MDL2 Assets"
                                           FontSize="15" Foreground="#CCFFFFFF"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bd" Property="Background" Value="#33FFFFFF"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="bd" Property="Background" Value="#55FFFFFF"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <!-- Выезжающие кнопки: Restart и Sleep -->
                <StackPanel x:Name="PowerExpandPanel"
                            Grid.Column="1"
                            Orientation="Horizontal"
                            Opacity="0"
                            Width="0"
                            ClipToBounds="True"
                            VerticalAlignment="Stretch">

                    <!-- ↺ Restart -->
                    <Button x:Name="BtnRestart"
                            Width="36" Height="36"
                            Cursor="Hand" ToolTip="Restart" Click="Restart_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="bd" Background="Transparent" BorderThickness="0">
                                    <TextBlock Text="&#xE777;" FontFamily="Segoe MDL2 Assets"
                                               FontSize="15" Foreground="#CCFFFFFF"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="bd" Property="Background" Value="#33FFFFFF"/>
                                    </Trigger>
                                    <Trigger Property="IsPressed" Value="True">
                                        <Setter TargetName="bd" Property="Background" Value="#55FFFFFF"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <!-- 💤 Sleep -->
                    <Button x:Name="BtnSleep"
                            Width="36" Height="36"
                            Cursor="Hand" ToolTip="Sleep" Click="Sleep_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="bd" Background="Transparent" BorderThickness="0">
                                    <TextBlock Text="&#xE708;" FontFamily="Segoe MDL2 Assets"
                                               FontSize="15" Foreground="#CCFFFFFF"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="bd" Property="Background" Value="#33FFFFFF"/>
                                    </Trigger>
                                    <Trigger Property="IsPressed" Value="True">
                                        <Setter TargetName="bd" Property="Background" Value="#55FFFFFF"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                </StackPanel>

                <!-- Placeholder -->
                <Border Grid.Column="2" Background="Transparent"/>

                <!-- 🔍 Search -->
                <Button x:Name="BtnToggleView" Grid.Column="3"
                        Cursor="Hand" ToolTip="Search" Click="Search_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="bd" Background="Transparent" BorderThickness="0">
                                <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets"
                                           FontSize="15" Foreground="#CCFFFFFF"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bd" Property="Background" Value="#33FFFFFF"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="bd" Property="Background" Value="#55FFFFFF"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <!-- ⚙ Settings -->
                <Button x:Name="BtnSettings" Grid.Column="4"
                        Cursor="Hand" ToolTip="Settings" Click="Settings_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="bd" Background="Transparent" BorderThickness="0">
                                <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets"
                                           FontSize="15" Foreground="#CCFFFFFF"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bd" Property="Background" Value="#33FFFFFF"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="bd" Property="Background" Value="#55FFFFFF"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

            </Grid>

            <!-- Плитки -->
            <StackPanel Margin="6,6,6,6">
                <StackPanel x:Name="TileView">
                    <TextBlock x:Name="LabelPrograms" Text="PROGRAMS"
                               Foreground="#55FFFFFF" FontSize="9" FontWeight="Bold"
                               Margin="2,0,0,4"/>
                    <UniformGrid x:Name="PanelPrograms" Columns="7"/>

                    <TextBlock x:Name="LabelGames" Text="GAMES"
                               Foreground="#55FFFFFF" FontSize="9" FontWeight="Bold"
                               Margin="2,8,0,4"/>
                    <UniformGrid x:Name="PanelGames" Columns="7"/>
                </StackPanel>
            </StackPanel>

        </StackPanel>
    </Border>
</Window>
