<Window x:Class="MyTaskbar.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MyTaskbar"
        Height="40"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        SizeToContent="Width"
        SizeChanged="Window_SizeChanged">

    <Window.Resources>

        <Style x:Key="IconButton" TargetType="Button">
            <Setter Property="Width" Value="40"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid Background="#01000000">
                            <Border x:Name="AppBorder"
                                    Background="Transparent"
                                    CornerRadius="0"/>
                            <Border x:Name="HoverBorder"
                                    Background="Transparent"
                                    CornerRadius="0"
                                    IsHitTestVisible="False"/>
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              IsHitTestVisible="False"/>
                            <Rectangle x:Name="RunBar"
                                       Height="2" Width="14"
                                       VerticalAlignment="Bottom"
                                       HorizontalAlignment="Center"
                                       Fill="#88C4FF"
                                       Margin="0,0,0,0"
                                       Visibility="Collapsed"
                                       RadiusX="1" RadiusY="1"
                                       IsHitTestVisible="False"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="HoverBorder" Property="Background" Value="#2EFFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="HoverBorder" Property="Background" Value="#50FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="MedIconButton" TargetType="Button" BasedOn="{StaticResource IconButton}">
            <Setter Property="Width" Value="26"/>
        </Style>

        <DropShadowEffect x:Key="MenuShadow" Color="Black" BlurRadius="20" ShadowDepth="4" Opacity="0.7"/>

        <Style x:Key="DarkContextMenu" TargetType="ContextMenu">
            <Setter Property="Background" Value="#1E1E1E"/>
            <Setter Property="BorderBrush" Value="#3A3A3A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="4"/>
            <Setter Property="Effect" Value="{StaticResource MenuShadow}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContextMenu">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <StackPanel IsItemsHost="True"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DarkMenuItem" TargetType="MenuItem">
            <Setter Property="Foreground" Value="#E0E0E0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Border x:Name="border" Background="{TemplateBinding Background}" Margin="2,1">
                            <ContentPresenter ContentSource="Header"
                                              Margin="{TemplateBinding Padding}"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#2E2E2E"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#666"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DarkMenuSeparator" TargetType="Separator">
            <Setter Property="Background" Value="#3A3A3A"/>
            <Setter Property="Height" Value="1"/>
            <Setter Property="Margin" Value="8,4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Separator">
                        <Rectangle Fill="{TemplateBinding Background}"
                                   Height="{TemplateBinding Height}"
                                   Margin="{TemplateBinding Margin}"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <!-- Фон убран из XAML — Acrylic/Blur применяется через WinAPI в AcrylicHelper.cs -->
    <Border Background="Transparent" x:Name="RootBorder">
        <StackPanel Orientation="Horizontal" Height="40" x:Name="MainPanel">

            <!-- Кнопка Старт -->
            <Button x:Name="StartButton" Style="{StaticResource IconButton}"
                    Click="StartButton_Click" ToolTip="Пуск">
                <UniformGrid Width="18" Height="18"
                             Rows="2" Columns="2"
                             IsHitTestVisible="False">
                    <Rectangle Fill="White" Margin="0,0,1,1"/>
                    <Rectangle Fill="White" Margin="1,0,0,1"/>
                    <Rectangle Fill="White" Margin="0,1,1,0"/>
                    <Rectangle Fill="White" Margin="1,1,0,0"/>
                </UniformGrid>
            </Button>

            <!-- Иконки приложений -->
            <StackPanel x:Name="AppIcons" Orientation="Horizontal"/>

            <!-- Разделитель -->
            <Rectangle Width="1" Height="20" Fill="#44FFFFFF"
                       VerticalAlignment="Center" Margin="3,0"
                       IsHitTestVisible="False"/>

            <!-- Кнопка "Показать скрытые значки" -->
            <Button x:Name="TrayButton" Style="{StaticResource MedIconButton}"
                    Width="26"
                    Tag="closed"
                    ToolTip="Скрытые значки"
                    Click="TrayButton_Click">
                <Grid IsHitTestVisible="False">
                    <TextBlock x:Name="TrayIconClosed"
           Text="&#xE70D;"
                               FontFamily="Segoe MDL2 Assets"
                               FontSize="15"
                               Foreground="White"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Center"
                               Visibility="Visible"/>
                    <TextBlock x:Name="TrayIconOpen"
           Text="&#xE70E;"
                               FontFamily="Segoe MDL2 Assets"
                               FontSize="15"
                               Foreground="White"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Center"
                               Visibility="Collapsed"/>
                </Grid>
            </Button>

            <!-- Яркость -->
            <Button x:Name="BrightnessButton" Style="{StaticResource MedIconButton}"
                    Width="28"
                    ToolTip="Яркость"
                    Click="BrightnessButton_Click">
                <TextBlock x:Name="BrightnessIcon"
                           Text="&#xE706;"
                           FontFamily="Segoe MDL2 Assets"
                           FontSize="18"
                           Foreground="White"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Center"
                           IsHitTestVisible="False"/>
            </Button>

            <!-- Громкость -->
            <Button x:Name="VolumeButton" Style="{StaticResource MedIconButton}"
                    Width="28"
                    ToolTip="Громкость"
                    Click="VolumeButton_Click">
                <TextBlock x:Name="VolumeIcon"
                           Text="&#xE767;"
                           FontFamily="Segoe MDL2 Assets"
                           FontSize="18"
                           Foreground="White"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Center"
                           IsHitTestVisible="False"/>
            </Button>

            <!-- Батарея -->
            <Button x:Name="BatteryButton" Style="{StaticResource MedIconButton}"
                    ToolTip="Батарея"
                    Visibility="Collapsed"
                    Width="38">
                <StackPanel Orientation="Horizontal"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Center"
                            IsHitTestVisible="False">
                    <TextBlock x:Name="BatteryLabel"
                               Text="100"
                               FontSize="13"
                               FontFamily="Segoe UI"
                               FontWeight="SemiBold"
                               Foreground="White"
                               VerticalAlignment="Center"
                               IsHitTestVisible="False"/>
                    <TextBlock x:Name="BatteryPercent"
                               Text="%"
                               FontSize="11"
                               FontFamily="Segoe UI"
                               FontWeight="SemiBold"
                               Foreground="White"
                               VerticalAlignment="Center"
                               Margin="1,0,0,0"
                               IsHitTestVisible="False"
                               Visibility="Visible"/>
                    <Ellipse x:Name="BatteryLightning"
                             Visibility="Collapsed"
                             Margin="3,0,0,0"
                             VerticalAlignment="Center"
                             IsHitTestVisible="False"
                             Fill="#48C78E"
                             Width="7" Height="7"/>
                </StackPanel>
            </Button>

            <!-- Язык ввода -->
            <Button x:Name="LangButton" Style="{StaticResource MedIconButton}"
                    Width="28"
                    ToolTip="Сменить раскладку (Alt+Shift)"
                    Click="LangButton_Click">
                <TextBlock x:Name="LangLabel" Text="RU"
                           FontSize="14"
                           FontFamily="Segoe UI" FontWeight="SemiBold"
                           Foreground="White" VerticalAlignment="Center"
                           HorizontalAlignment="Center"
                           IsHitTestVisible="False"/>
            </Button>

            <!-- Bluetooth -->
            <Button x:Name="BluetoothButton" Style="{StaticResource MedIconButton}"
                    Width="28"
                    ToolTip="Bluetooth"
                    Click="BluetoothButton_Click">
                <Canvas x:Name="BluetoothCanvas"
                        Width="12" Height="14"
                        IsHitTestVisible="False">
                    <Path x:Name="BluetoothIcon"
                          Data="M 5,0 L 5,16 M 5,0 L 10,4 L 5,8 L 10,12 L 5,16 M 5,8 L 0,4 M 5,8 L 0,12"
                          Stretch="Uniform"
                          Width="12" Height="14"
                          Stroke="#60AAAAAA"
                          StrokeThickness="1.5"
                          StrokeLineJoin="Round"
                          StrokeStartLineCap="Round"
                          StrokeEndLineCap="Round"
                          Fill="Transparent"
                          SnapsToDevicePixels="True"/>
                </Canvas>
            </Button>

            <!-- WiFi -->
            <Button x:Name="WifiButton" Style="{StaticResource MedIconButton}"
                    Width="28"
                    ToolTip="Сети WiFi"
                    Click="WifiButton_Click">
                <TextBlock x:Name="WifiIcon"
                           Text="&#xE701;"
                           FontFamily="Segoe MDL2 Assets"
                           FontSize="22"
                           Foreground="White"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Center"
                           Margin="0,-3,0,0"
                           IsHitTestVisible="False"/>
            </Button>

            <!-- Разделитель -->
            <Rectangle Width="1" Height="20" Fill="#44FFFFFF"
                       VerticalAlignment="Center" Margin="3,0"
                       IsHitTestVisible="False"/>

            <!-- Часы и дата -->
            <Border Height="40" Background="#01000000"
                    Cursor="Hand" ToolTip="Дата и время"
                    Padding="8,0"
                    Margin="0,0,4,0">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                            IsHitTestVisible="False">
                    <TextBlock x:Name="TimeLabel" Foreground="White"
                               FontSize="13" FontFamily="Segoe UI"
                               HorizontalAlignment="Center" Text="00:00"/>
                    <TextBlock x:Name="DateLabel" Foreground="White"
                               FontSize="13" FontFamily="Segoe UI"
                               HorizontalAlignment="Center" Text="01.01.2026"/>
                </StackPanel>
            </Border>

        </StackPanel>
    </Border>
</Window>
