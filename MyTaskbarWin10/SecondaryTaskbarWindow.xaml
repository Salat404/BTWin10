<Window x:Class="MyTaskbar.SecondaryTaskbarWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MyTaskbar2"
        Height="40"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        SizeToContent="Width"
        UseLayoutRounding="True"
        SizeChanged="Window_SizeChanged">

    <Window.Resources>

        <Style x:Key="IconButton" TargetType="Button">
            <Setter Property="Width" Value="40"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid Background="#01000000">
                            <Border x:Name="AppBorder"
                                    Background="Transparent"/>
                            <Border x:Name="HoverBorder"
                                    Background="Transparent"/>
                            <Rectangle x:Name="RunBar"
                                       Height="2" Width="14"
                                       Fill="White"
                                       VerticalAlignment="Bottom"
                                       HorizontalAlignment="Center"
                                       Margin="0,0,0,0"
                                       IsHitTestVisible="False"
                                       Visibility="Collapsed"
                                       RadiusX="1" RadiusY="1"/>
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="HoverBorder" Property="Background" Value="#2EFFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="HoverBorder" Property="Background" Value="#50FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="MedIconButton" TargetType="Button" BasedOn="{StaticResource IconButton}">
            <Setter Property="Width" Value="26"/>
        </Style>

        <Style x:Key="DarkContextMenu" TargetType="ContextMenu">
            <Setter Property="Background" Value="#1E1E2E"/>
            <Setter Property="BorderBrush" Value="#333344"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="2"/>
            <Setter Property="MinWidth" Value="0"/>
        </Style>

        <Style x:Key="DarkMenuItem" TargetType="MenuItem">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Border x:Name="border" Background="{TemplateBinding Background}" Margin="1,1"
                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter ContentSource="Header"
                                              HorizontalAlignment="Left"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#333333"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DarkMenuSeparator" TargetType="Separator">
            <Setter Property="Background" Value="#333344"/>
            <Setter Property="Height" Value="1"/>
            <Setter Property="Margin" Value="8,2"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Separator">
                        <Rectangle Fill="{TemplateBinding Background}"
                                   Height="{TemplateBinding Height}"
                                   HorizontalAlignment="Stretch"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <Border Background="Transparent" x:Name="RootBorder"
            SnapsToDevicePixels="True">
        <Grid>
        <StackPanel Orientation="Horizontal" Height="40" x:Name="MainPanel">
            <!-- Кнопка Старт -->
            <Button x:Name="StartButton" Style="{StaticResource IconButton}"
                    Click="StartButton_Click" ToolTip="Start"
                    MouseRightButtonUp="StartButton_RightClick">
                <UniformGrid Width="18" Height="18"
                             Rows="2" Columns="2"
                             IsHitTestVisible="False">
                    <Rectangle Fill="White" Margin="0,0,1,1"/>
                    <Rectangle Fill="White" Margin="1,0,0,1"/>
                    <Rectangle Fill="White" Margin="0,1,1,0"/>
                    <Rectangle Fill="White" Margin="1,1,0,0"/>
                </UniformGrid>
            </Button>

            <!-- Иконки приложений (синхронизируются с главной панелью) -->
            <StackPanel x:Name="AppIcons" Orientation="Horizontal"/>

            <!-- Разделитель -->
            <Rectangle Width="1" Height="20" Fill="#44FFFFFF"
                       VerticalAlignment="Center" Margin="3,0"
                       IsHitTestVisible="False"/>

            <!-- Кнопка "Показать скрытые значки" -->
            <Button x:Name="TrayButton" Style="{StaticResource MedIconButton}"
                    Width="26"
                    Tag="closed"
                    ToolTip="Hidden icons"
                    Click="TrayButton_Click">
                <Grid IsHitTestVisible="False">
                    <TextBlock x:Name="TrayIconClosed"
                               Text="&#xE70D;"
                               FontFamily="Segoe MDL2 Assets"
                               FontSize="15"
                               Foreground="White"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Center"
                               Visibility="Visible"/>
                    <TextBlock x:Name="TrayIconOpen"
                               Text="&#xE70E;"
                               FontFamily="Segoe MDL2 Assets"
                               FontSize="15"
                               Foreground="White"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Center"
                               Visibility="Collapsed"/>
                </Grid>
            </Button>

            <!-- Яркость -->
            <Button x:Name="BrightnessButton" Style="{StaticResource MedIconButton}"
                    Width="28"
                    ToolTip="Brightness"
                    Click="BrightnessButton_Click">
                <TextBlock x:Name="BrightnessIcon"
                           Text="&#xE706;"
                           FontFamily="Segoe MDL2 Assets"
                           FontSize="18"
                           Foreground="White"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Center"
                           IsHitTestVisible="False"/>
            </Button>

            <!-- Громкость -->
            <Button x:Name="VolumeButton" Style="{StaticResource MedIconButton}"
                    Width="28"
                    ToolTip="Volume"
                    Click="VolumeButton_Click"
                    MouseRightButtonUp="VolumeButton_RightClick">
                <TextBlock x:Name="VolumeIcon"
                           Text="&#xE767;"
                           FontFamily="Segoe MDL2 Assets"
                           FontSize="18"
                           Foreground="White"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Center"
                           IsHitTestVisible="False"/>
            </Button>

            <!-- Батарея -->
            <Button x:Name="BatteryButton" Style="{StaticResource MedIconButton}"
                    ToolTip="Battery"
                    Visibility="Collapsed"
                    Width="38">
                <StackPanel Orientation="Horizontal"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Center"
                            IsHitTestVisible="False">
                    <TextBlock x:Name="BatteryLabel"
                               Text="100"
                               FontSize="16"
                               FontFamily="Segoe UI"
                               FontWeight="SemiBold"
                               Foreground="White"
                               VerticalAlignment="Center"
                               Margin="0,-1.5,0,0"
                               IsHitTestVisible="False"/>
                    <TextBlock x:Name="BatteryPercent"
                               Text="%"
                               FontSize="16"
                               FontFamily="Segoe UI"
                               FontWeight="SemiBold"
                               Foreground="White"
                               VerticalAlignment="Center"
                               Margin="1,-1.5,0,0"
                               IsHitTestVisible="False"
                               Visibility="Visible"/>
                    <Ellipse x:Name="BatteryLightning"
                             Visibility="Collapsed"
                             Margin="3,0,0,0"
                             VerticalAlignment="Center"
                             IsHitTestVisible="False"
                             Fill="#48C78E"
                             Width="7" Height="7"/>
                </StackPanel>
            </Button>

            <!-- Язык ввода -->
            <Button x:Name="LangButton" Style="{StaticResource MedIconButton}"
                    Width="28"
                    Click="LangButton_Click"
                    MouseRightButtonDown="LangButton_RightClick">
                <TextBlock x:Name="LangLabel" Text="RU"
                           FontSize="14"
                           FontFamily="Segoe UI" FontWeight="SemiBold"
                           Foreground="White" VerticalAlignment="Center"
                           HorizontalAlignment="Center"
                           IsHitTestVisible="False"/>
            </Button>

            <!-- Bluetooth -->
            <Button x:Name="BluetoothButton" Style="{StaticResource MedIconButton}"
                    Width="28"
                    ToolTip="Bluetooth"
                    Click="BluetoothButton_Click">
                <Canvas x:Name="BluetoothCanvas"
                        Width="12" Height="14"
                        IsHitTestVisible="False">
                    <Path x:Name="BluetoothIcon"
                          Data="M 5,0 L 5,16 M 5,0 L 10,4 L 5,8 L 10,12 L 5,16 M 5,8 L 0,4 M 5,8 L 0,12"
                          Stretch="Uniform"
                          Width="12" Height="14"
                          Stroke="#60AAAAAA"
                          StrokeThickness="1.5"
                          StrokeLineJoin="Round"
                          StrokeStartLineCap="Round"
                          StrokeEndLineCap="Round"
                          Fill="Transparent"
                          SnapsToDevicePixels="True"/>
                </Canvas>
            </Button>

            <!-- WiFi -->
            <Button x:Name="WifiButton" Style="{StaticResource MedIconButton}"
                    Width="28"
                    ToolTip="Wi-Fi networks"
                    Click="WifiButton_Click">
                <TextBlock x:Name="WifiIcon"
                           Text="&#xE701;"
                           FontFamily="Segoe MDL2 Assets"
                           FontSize="22"
                           Foreground="White"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Center"
                           Margin="0,-3,0,0"
                           IsHitTestVisible="False"/>
            </Button>

            <!-- Разделитель -->
            <Rectangle Width="1" Height="20" Fill="#44FFFFFF"
                       VerticalAlignment="Center" Margin="3,0"
                       IsHitTestVisible="False"/>

            <!-- Часы и дата -->
            <Border Height="40" Background="#01000000"
                    Cursor="Hand" ToolTip="Date and time"
                    Padding="8,0"
                    Margin="0,0,4,0">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                            IsHitTestVisible="False">
                    <TextBlock x:Name="TimeLabel" Foreground="White"
                               FontSize="13" FontFamily="Segoe UI"
                               HorizontalAlignment="Center" Text="00:00"/>
                    <TextBlock x:Name="DateLabel" Foreground="White"
                               FontSize="13" FontFamily="Segoe UI"
                               HorizontalAlignment="Center" Text="01.01.2026"/>
                </StackPanel>
            </Border>

        </StackPanel>

            <!-- Линии обводки -->
            <Rectangle x:Name="BorderLineTop"
                       Height="1" VerticalAlignment="Top" HorizontalAlignment="Stretch"
                       Fill="#22FFFFFF" IsHitTestVisible="False"
                       Visibility="Visible"/>
            <Rectangle x:Name="BorderLineBottom"
                       Height="1" VerticalAlignment="Bottom" HorizontalAlignment="Stretch"
                       Fill="#22FFFFFF" IsHitTestVisible="False"
                       Visibility="Collapsed"/>
            <Rectangle x:Name="BorderLineRight"
                       Width="1" HorizontalAlignment="Right" VerticalAlignment="Stretch"
                       Fill="#22FFFFFF" IsHitTestVisible="False"/>
        </Grid>
    </Border>
</Window>
